{
  "name": "asr-accessibility-scan",
  "version": "1.0.0",
  "description": "Attorney Site Rescue accessibility scanner - WCAG 2.2 Level AA automated testing",
  "main": "index.js",
  "type": "module",
  "bin": {
    "asr-scan": "./cli.js"
  },
  "scripts": {
    "scan": "node cli.js",
    "demo": "node cli.js examples/sample-urls.txt --label demo --output examples/demo-output"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "a11y",
    "axe",
    "lighthouse",
    "pa11y",
    "law-firm"
  ],
