  "license": "MIT",
  "dependencies": {
    "axe-core": "4.8.2",
    "commander": "11.1.0",
    "lighthouse": "11.3.0",
    "pa11y": "8.0.0",
    "playwright": "1.40.1",
    "puppeteer": "21.6.1",
    "xml2js": "0.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
